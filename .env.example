# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=vtuva

# Optional direct connection URI override
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/vtuva

# LLM Provider Configuration: 'ollama' (local) | 'groq' (cloud) | 'gemini' (cloud)
LLM_PROVIDER=ollama

# Local Ollama Configuration (For Development & Testing)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional Google Gemini API Configuration
# GOOGLE_API_KEY=your_gemini_api_key_here
