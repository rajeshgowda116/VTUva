# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=vtuva

# Optional direct connection URI override
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/vtuva

# Groq API Key for Ultra-Fast RAG Answer Generation (Primary)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Google Gemini API Key (Fallback)
# GOOGLE_API_KEY=your_gemini_api_key_here
